{
  "name": "lexigov-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "lint:turbo": "turbo lint",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @lexigov/api test:e2e",
    "db:generate": "pnpm --filter @lexigov/api db:generate",
    "db:migrate": "pnpm --filter @lexigov/api db:migrate",
    "db:seed": "pnpm --filter @lexigov/api db:seed",
    "db:studio": "pnpm --filter @lexigov/api db:studio",
    "dev:web": "turbo dev --filter=@lexigov/web",
    "dev:api": "turbo dev --filter=@lexigov/api",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@lexigov/shared": "workspace:*",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  }
}
