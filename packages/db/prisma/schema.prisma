// Prisma Schema for LexiGov AI
// Philippine Ordinance Database Structure

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Roles Enum
enum UserRole {
  ADMIN
  LEGISLATIVE_STAFF
  BARANGAY_SECRETARY
  CITY_COUNCIL
  RESEARCHER
}

// Document Types Enum
enum DocumentType {
  ORDINANCE
  RESOLUTION
  MEMORANDUM
  POLICY
}

// Document Status Workflow Enum
enum DocumentStatus {
  DRAFT
  REVIEW
  FINAL
  ARCHIVED
}

// Jurisdiction Level Enum
enum JurisdictionLevel {
  BARANGAY
  CITY
  MUNICIPAL
  PROVINCIAL
}

// Audit Action Types
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EXPORT
  AI_GENERATE
  RESTORE_VERSION
  MERGE_AMENDMENT
  SIGN_DOCUMENT
}

// User Table
// Stores user accounts and authentication data
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  passwordHash    String?
  role            UserRole @default(LEGISLATIVE_STAFF)
  organization     String?  // LGU name
  firebaseUid     String?  // Firebase user ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  drafts          Draft[]
  templates       Template[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role])
  @@index([firebaseUid])
}

// Draft Table
// Stores ordinance drafts and versions
model Draft {
  id              String        @id @default(cuid())
  title           String
  documentType    DocumentType
  jurisdiction    JurisdictionLevel
  jurisdictionName String

  // Structured content (JSON)
  content         Json          // Stores PhilippineOrdinance structure

  status          DocumentStatus @default(DRAFT)
  aiGenerated     Boolean        @default(false)

  // Relations
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId      String?
  template        Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)

  version         Int            @default(1)
  parentDraftId   String?        // For versioning
  parentDraft     Draft?         @relation("DraftVersions", fields: [parentDraftId], references: [id], onDelete: Cascade)
  versions        Draft[]        @relation("DraftVersions")

  // Additional relations
  versionComparisons  VersionComparison[]
  exportHistories    ExportHistory[]
  complianceReports  ComplianceReport[]

  // Audit fields
  commitMessage   String?

  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([version])
  @@index([createdAt])
}

// Template Table
// Pre-built ordinance templates
model Template {
  id              String            @id @default(cuid())
  name            String
  category         String             // Environment, Health, Public Safety, etc.
  subcategory      String?
  jurisdiction    JurisdictionLevel[]

  // Template structure with placeholders
  structure        Json              // TemplateStructure type
  exampleContent   Json?             // Sample filled ordinance

  isPublic        Boolean           @default(true)
  usageCount      Int               @default(0)

  // Relations
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  drafts          Draft[]

  // Timestamps
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([category])
  @@index([jurisdiction])
  @@index([isPublic])
}

// Audit Log Table
// Tracks all user actions for compliance and audit trail
model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String      // "Draft", "Template", etc.
  entityId    String      // ID of the entity
  changes     Json?       // Diff of changes

  userId      String
  user        User        @relation(fields: [userId], references: [id])

  ipAddress   String?

  createdAt   DateTime    @default(now())

  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// Version History Table (Optional)
// Detailed version comparison data
model VersionComparison {
  id              String   @id @default(cuid())
  draftId         String
  draft           Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)

  versionFrom      Int
  versionTo        Int

  // Changes summary
  changes         Json

  createdAt       DateTime @default(now())

  @@index([draftId])
}

// Export History Table
// Tracks document exports (PDF, DOCX)
model ExportHistory {
  id              String       @id @default(cuid())
  draftId         String
  draft           Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)

  exportType      String       // "PDF", "DOCX"
  fileUrl         String       // Cloud Storage URL
  fileSize        Int          // Bytes
  pageCount        Int?

  exportedBy       String       // User who exported

  createdAt       DateTime     @default(now())

  @@index([draftId])
  @@index([createdAt])
}

// Compliance Report Table
// Stores AI compliance check results
model ComplianceReport {
  id              String    @id @default(cuid())
  draftId         String
  draft           Draft      @relation(fields: [draftId], references: [id], onDelete: Cascade)

  // Compliance scores
  overallScore    Int        // 0-100
  isValid         Boolean
  issuesCount     Int
  warningsCount   Int
  suggestionsCount Int

  // Detailed issues
  issues          Json       // ComplianceIssue[]

  checkedAt       DateTime   @default(now())

  @@index([draftId])
  @@index([checkedAt])
}
