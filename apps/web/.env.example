# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"

# Database (for Prisma client in web app)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lexigov?schema=public"

# API URL (NestJS backend)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Azure OpenAI
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"

# Email (optional - defaults to console provider in dev)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM="LexiGov AI <no-reply@yourdomain.com>"
