# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lexigov?schema=public"

# Better Auth (share same secret with web app for session validation)
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Azure OpenAI
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY="your-api-key"
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"

# API
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Redis (optional; when set, session caching uses Redis instead of in-memory fallback)
# REDIS_URL="redis://localhost:6379"

# Rate limiting (optional overrides - see app.module.ts for defaults)
# THROTTLE_DEFAULT_LIMIT=120
# THROTTLE_AI_LIMIT=10
# THROTTLE_TTL_MS=60000

# Sentry error tracking (set to enable)
# SENTRY_DSN=https://key@oXXX.ingest.sentry.io/project
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
# LOG_LEVEL=debug

# Artifact Storage (S3 / S3-compatible) - optional; falls back to in-memory when unset
# S3_BUCKET="lexigov-artifacts"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE=false
