# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lexigov"

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:8080"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Firebase
# Get these from Firebase Console (Project Settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# Google Cloud Platform (GCP) - Vertex AI
# Get credentials from GCP Console
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_LOCATION="asia-southeast2"
GOOGLE_CLOUD_VERTEX_AI_ENDPOINTS="https://asia-southeast2-aiplatform.googleapis.com"

# Application
NODE_ENV="development"
LOG_LEVEL="info"

# JWT Secret (for backend auth)
JWT_SECRET="your-secret-key-change-in-production"
