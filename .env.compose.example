# Copy to .env and replace every CHANGE_ME value before running Docker Compose.
POSTGRES_USER=lexigov
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=lexigov
DATABASE_URL=postgresql://lexigov:CHANGE_ME_DATABASE_PASSWORD@db:5432/lexigov?schema=public

APP_URL=https://lexigov.example.gov.ph
BETTER_AUTH_URL=https://lexigov.example.gov.ph
BETTER_AUTH_TRUSTED_ORIGINS=https://lexigov.example.gov.ph
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGIN=https://lexigov.example.gov.ph
NEXT_PUBLIC_API_URL=https://api.lexigov.example.gov.ph/api

AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://CHANGE_ME.openai.azure.com
AZURE_OPENAI_API_KEY=CHANGE_ME
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=CHANGE_ME

EMAIL_PROVIDER=resend
EMAIL_FROM=LexiGov AI <no-reply@example.gov.ph>
RESEND_API_KEY=CHANGE_ME

# Optional
SENTRY_DSN=
API_PUBLISHED_PORT=4000
WEB_PUBLISHED_PORT=3000
